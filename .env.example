# =============================================================================
#  MarkaLab · Variables de entorno
#  Dónde van:  Vercel → proyecto → Settings → Environment Variables (Production)
#  Las que empiezan con NEXT_PUBLIC_ se graban al compilar y viajan al navegador:
#  no son secretas. Las demás solo existen en el servidor.
#  Después de agregar o cambiar una variable: Deployments → ⋯ → Redeploy.
# =============================================================================

# ------------------------------------------------------------------ sitio
NEXT_PUBLIC_SITE_URL=https://www.markalab.com.mx          # sitemap, robots y etiquetas para redes

# ------------------------------------------------- Kala · chat de texto
# n8n: "MarkaLab Agente Web MASTER" (Workflows/MkL/ML-Agent), webhook /markalab-chat.
# El nodo "Validar entrada" exige el encabezado x-markalab-token = NEXT_PUBLIC_KALA_TOKEN.
# Sin NEXT_PUBLIC_KALA_ENDPOINT el botón de Kala NO aparece.
# Ya vienen en .env.production (en el repositorio), así Kala funciona en cualquier proyecto de Vercel.
NEXT_PUBLIC_KALA_ENDPOINT=https://ludwigsistemas.app.n8n.cloud/webhook/markalab-chat
NEXT_PUBLIC_KALA_TOKEN=

# --------------------------------------------- Kala · voz (dos modos)
# 1) Retell (llamada en vivo). Si las dos existen, el micrófono usa Retell.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=                             # llave pública, restringida a markalab.com.mx
NEXT_PUBLIC_RETELL_AGENT_ID=                               # agente de Kala
# 2) Respaldo por n8n (webhook /markalab-voz), usa el mismo NEXT_PUBLIC_KALA_TOKEN.
NEXT_PUBLIC_KALA_VOZ_ENDPOINT=https://ludwigsistemas.app.n8n.cloud/webhook/markalab-voz

# ---------------------------------- Demo del Cold Caller (/demo) · ML-116
NEXT_PUBLIC_RETELL_AGENT_DEMO_ID=                          # agente adaptable de la demo (otro, no el de Kala)
N8N_DEMO_TOKEN=                                            # token que esperan los webhooks de la demo
N8N_DEMO_WEBHOOK_URL=https://ludwigsistemas.app.n8n.cloud/webhook/markalab-demo-lead
N8N_DEMO_HORARIOS_URL=https://ludwigsistemas.app.n8n.cloud/webhook/markalab-demo-horarios
N8N_DEMO_CITA_URL=https://ludwigsistemas.app.n8n.cloud/webhook/markalab-demo-cita
N8N_DEMO_TOKEN_URL=https://ludwigsistemas.app.n8n.cloud/webhook/markalab-demo-token   # código por correo

# ------------------------------- Landing de Talleres (/talleres) · Cold Mailing W5
N8N_WEBHOOK_URL=https://ludwigsistemas.app.n8n.cloud/webhook/cm-landing?k=REEMPLAZAR

# ------------------------------- Puente de chat del servidor (/api/chat) · opcional
# Ruta de respaldo: reenvía al mismo webhook del chat desde el servidor.
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_TOKEN=
