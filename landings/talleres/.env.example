# Copie este archivo como .env.local y llene los valores.
# .env.local NO se sube a GitHub (esta en .gitignore).

# URL completa del webhook de n8n que recibe los leads de la landing.
# Es el workflow "ML-Cold Mailing · W5 Entrada desde la landing".
# Incluya el parametro ?k= con el secreto, igual que en SmartLead.
N8N_WEBHOOK_URL=https://ludwigsistemas.app.n8n.cloud/webhook/cm-landing?k=REEMPLAZAR

# Opcional. ID de Google Analytics 4 (G-XXXXXXXXXX). Vacio = sin analitica.
NEXT_PUBLIC_GA_ID=

# Opcional. Dominio publico, para las etiquetas de compartir.
NEXT_PUBLIC_SITE_URL=https://www.markalab.com.mx
